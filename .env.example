# Otari service key (Dashboard > API keys > Create key > Advanced > Service key)
OTARI_SERVICE_KEY=
# The end-user budget new visitors start on (GET /api/v1/end-user-budgets shows ids)
OTARI_END_USER_BUDGET_ID=
# Routing policy (or a model id) for the reading step; DRILL_MODEL is the fallback-drill policy
EXTRACT_MODEL=sl-reader
DRILL_MODEL=sl-drill
# Id of the MCP server stored under Tools > MCP servers (pointing at <deployment>/api/mcp)
OTARI_MCP_SERVER_IDS=
# Public HTTPS address of this deployment (Otari calls back to /api/guard and /api/mcp)
PUBLIC_BASE_URL=
# Shared secret Otari sends to the guardrail service as a Bearer credential
GUARD_TOKEN=
